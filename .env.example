# Copy to .env.local in apps/web (never commit real values)

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Accessibility statement contact (Israeli regulation 35, docs/ACCESSIBILITY.md). Server-only,
# read at build time. Until set, /accessibility says the details are being published.
A11Y_CONTACT_NAME=
A11Y_CONTACT_EMAIL=
A11Y_CONTACT_PHONE=
